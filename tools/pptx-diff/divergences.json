  {
    "id": "doctype-refused",
    "reason": "DOCTYPE is refused by policy; the TypeScript XML parser accepts this declaration.",
    "cases": [
      {
        "fn": "pptxXml.parseObject",
        "text": "<!DOCTYPE a><a/>",
        "args": {
          "arrayNames": ["c:ser", "c:pt", "c:lvl", "c:dPt"],
          "trimValues": false,
          "parseTagValue": false
        },
        "typescript": {
          "value": {
            "a": ""
          }
        },
        "rust": {
          "error": "document type declarations are not supported"
        }
      },
      {
        "fn": "pptxXml.parseObject",

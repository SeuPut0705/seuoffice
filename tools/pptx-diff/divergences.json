  {
    "id": "cdata-opener-splits-surrogate",
    "reason": "Malformed CDATA opener splits a UTF-16 surrogate pair in TypeScript; Rust strings cannot represent a lone surrogate and refuse it.",
    "cases": [
      {
        "fn": "pptxXml.parseObject",
        "text": "<a><![CDATA😀]]></a>",
        "args": {
          "arrayNames": ["c:ser", "c:pt", "c:lvl", "c:dPt"],
          "trimValues": false,
          "parseTagValue": false
        },
        "typescript": {
          "value": {
            "a": "\ude00"
          }
        },
        "rust": {
          "error": "a surrogate pair would be split"
        }
      },

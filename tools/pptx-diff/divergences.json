  {
    "id": "slide-id-xml-whitespace",
    "reason": "TypeScript defect, reported 2026-11-12, fix pending on main. XML whitespace around the id attribute equals sign must not hide an existing slide id.",
    "cases": [
      {
        "fn": "pptxLeaves.slide-ids.nextSlideId",
        "text": "<p:presentation xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\" xmlns:p=\"http://schemas.openxmlformats.org/presentationml/2006/main\" xmlns:mc=\"http://schemas.openxmlformats.org/markup-compatibility/2006\"><p:sldMasterIdLst/><p:sldIdLst><p:sldId id = \"600\"/><p:sldId id=\"-700\"/><p:sldId id=\"7e2\"/></p:sldIdLst><p:sldSz cx=\"1\" cy=\"1\"/></p:presentation>",
        "args": {},
        "typescript": {
          "value": 256
        },
        "rust": {
          "value": 601
        }
      }
    ]
  },

{
  "name": "pptx-diff",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Parity gate for the Rust slides engine against packages/pptx-engine",
  "scripts": {
    "gate": "node run.mjs",
    "calls": "node run.mjs --calls-only",
    "faults": "node faults.mjs",
    "typecheck": "tsc --noEmit",
    "graph": "node module-graph.mjs"
  }
}

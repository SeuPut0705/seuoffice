{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // the TypeScript under comparison is the shell's: its settings, so its
    // imports (the shared UI types among them) check as they do there
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client", "electron"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  // the shell's ambient declarations, in the shell's order (apps/shell/tsconfig.json)
  "include": [
    "../../apps/slides/src/main/env.d.ts",
    "../../apps/docs/src/main/env.d.ts",
    "../../packages/html2docx/src/raw.d.ts",
    "../../packages/pdf2docx/src/bidi-js.d.ts",
    "*.ts",
    "groups/*.ts"
  ]
}

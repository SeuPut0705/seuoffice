{
  "name": "@seuoffice/file-parse",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "shared attachment parsing: PDF, Office, HWP and plain-text formats to text, read by the Rust readers (crates/file-parse) through the wasm engine; images flagged for multimodal input",
  "exports": {
    ".": {
      "node": "./src/node/index.ts",
      "default": "./src/index.ts"
    },
    "./hwp": {
      "node": "./src/node/hwp.ts",
      "default": "./src/hwp.ts"
    },
    "./redaction": {
      "node": "./src/node/redaction.ts",
      "default": "./src/redaction.ts"
    },
    "./init": "./src/init.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@seuoffice/drawio-model": "*",
    "@seuoffice/engine-wasm": "*",
    "@seuoffice/epub-engine": "*",
    "@seuoffice/odt-engine": "*",
    "@seuoffice/xlsx-gateway": "*",
    "@seuoffice/xmind-engine": "*",
    "@rhwp/core": "file:../../vendor/rhwp-core",
    "parse5": "^8.0.1",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "@seuoffice/agent-core": "*",
    "@seuoffice/compound-file": "*",
    "@seuoffice/docx-engine": "*",
    "@types/node": "^24.10.1",
    "cfb": "^1.2.2",
    "fast-xml-parser": "^5.3.4",
    "jszip": "^3.10.1",
    "ppt-to-text": "^1.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "word-extractor": "^1.0.4"
  }
}

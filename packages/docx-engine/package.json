{
  "name": "@seuoffice/docx-engine",
  "version": "0.1.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "description": "docx parsing (Block tree with docxIndex anchors), OOXML fragment generation, paragraph-patch save",
  "exports": {
    ".": {
      "node": "./src/node/index.ts",
      "default": "./src/index.ts"
    },
    "./math": {
      "node": "./src/node/math.ts",
      "default": "./src/math.ts"
    },
    "./metafile": "./src/metafile.ts",
    "./zip-splice": {
      "node": "./src/node/zip-splice.ts",
      "default": "./src/zip-splice.ts"
    },
    "./lazy-media": {
      "node": "./src/node/lazy-media.ts",
      "default": "./src/lazy-media.ts"
    },
    "./init": "./src/engine-init.ts",
    "./engine-url": "./src/engine-url.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "tsx scripts/generate-fixtures.ts"
  },
  "dependencies": {
    "@exodus/bytes": "1.15.1",
    "@seuoffice/engine-wasm": "*",
    "@seuoffice/pptx-engine": "*",
    "@seuoffice/zip-gate": "*",
    "fast-xml-parser": "^5.3.4",
    "jszip": "^3.10.1",
    "utif2": "^4.1.0",
    "@seuoffice/agent-core": "*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}

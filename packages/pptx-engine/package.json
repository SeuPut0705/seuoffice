{
  "name": "@seuoffice/pptx-engine",
  "version": "0.1.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "description": "pptx parsing (Slide element tree with byte anchors + inheritance resolution), OOXML fragment generation, element-patch save",
  "exports": {
    ".": {
      "node": "./src/node/index.ts",
      "default": "./src/index.ts"
    },
    "./custgeom": {
      "node": "./src/node/custgeom.ts",
      "default": "./src/custgeom.ts"
    },
    "./table-grid": {
      "node": "./src/node/table-grid.ts",
      "default": "./src/table-grid.ts"
    },
    "./identity": {
      "node": "./src/node/identity.ts",
      "default": "./src/identity.ts"
    },
    "./chart-workbook": {
      "node": "./src/node/chart-workbook.ts",
      "default": "./src/chart-workbook.ts"
    },
    "./dgm-hier": {
      "node": "./src/node/dgm-hier.ts",
      "default": "./src/dgm-hier.ts"
    },
    "./model3d": {
      "node": "./src/node/model3d.ts",
      "default": "./src/model3d.ts"
    },
    "./named-action": {
      "node": "./src/node/named-action.ts",
      "default": "./src/named-action.ts"
    },
    "./background-promote": {
      "node": "./src/node/background-promote.ts",
      "default": "./src/background-promote.ts"
    },
    "./init": "./src/engine-init.ts",
    "./engine-url": "./src/engine-url.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@seuoffice/agent-core": "*",
    "@seuoffice/engine-wasm": "*",
    "fast-xml-parser": "^5.3.4",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "pptxgenjs": "^4.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}

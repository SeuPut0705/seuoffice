{
  "name": "@seuoffice/embed",
  "version": "0.1.0",
  "license": "FSL-1.1-ALv2",
  "description": "Open a document in a seuoffice iframe from its bytes and file name",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeuPut0705/seuoffice.git",
    "directory": "packages/embed"
  },
  "homepage": "https://github.com/SeuPut0705/seuoffice#readme",
  "bugs": {
    "url": "https://github.com/SeuPut0705/seuoffice/issues"
  },
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "seuoffice-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE-APACHE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/seuoffice-prepack.mjs && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "jsdom": "^28.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}

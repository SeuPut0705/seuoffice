{
  "name": "@seuoffice/odt-engine",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "OpenDocument Text (.odt) bridge over the Rust engine: ODT to docx for the Word editor, narrow-patch save back into the original ODT, docx to ODT export",
  "exports": {
    ".": {
      "node": "./src/node/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@seuoffice/engine-wasm": "*"
  },
  "devDependencies": {
    "@seuoffice/docx-engine": "*",
    "@types/node": "^24.10.1",
    "jszip": "^3.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}

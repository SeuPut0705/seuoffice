{
  "name": "@seuoffice/doc2docx",
  "version": "0.1.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "description": "Legacy Word 97-2003 import: parse .doc (OLE2/CFB + FIB/piece table) and rebuild it as .docx; staged as text foundation, then formatting, then styles/tables/images",
  "exports": {
    ".": "./src/index.ts",
    "./compound": "./src/compound.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@seuoffice/compound-file": "*",
    "@seuoffice/docx-engine": "*",
    "cfb": "^1.2.2",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    // resolve the sibling source package by path (worktree-safe: a linked
    // node_modules would otherwise typecheck against another checkout) —
    // same mapping as packages/pdf2docx/tsconfig.json
    "paths": {
      "@seuoffice/docx-engine": ["../../packages/docx-engine/src/index.ts"],
      "@seuoffice/font-metrics": ["../../packages/font-metrics/src/index.ts"],
      "@seuoffice/electron-utils/headless-export": [
        "../../packages/electron-utils/src/headless-export.ts"
      ],
      "@seuoffice/electron-utils": ["../../packages/electron-utils/src/index.ts"],
      "@seuoffice/ai-provider": ["../../packages/ai-provider/src/index.ts"],
      "@seuoffice/i18n": ["../../packages/i18n/src/index.ts"],
      "@seuoffice/ui": ["../../packages/ui/src/index.ts"],
      "@seuoffice/pptx-engine": ["../../packages/pptx-engine/src/index.ts"],
      "@seuoffice/cli/install": ["../../packages/cli/src/install.ts"],
      "@seuoffice/cli/agent-skills": ["../../packages/cli/src/agent-skills.ts"],
      "@seuoffice/cli/control-protocol": ["../../packages/cli/src/control-protocol.ts"]
    }
  },
  // The ambient declarations come first: two of them declare 'bidi-js', and the
  // one read last wins the merged default export. The pdf2docx one (the full
  // API) must stay last, also when a source file pulls it in by reference.
  "include": [
    "../slides/src/main/env.d.ts",
    "../../packages/html2docx/src/raw.d.ts",
    "../../packages/pdf2docx/src/bidi-js.d.ts",
    "electron.vite.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}

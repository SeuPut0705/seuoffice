    "@seuoffice/engine-wasm": "*",
    "@seuoffice/file-parse": "*",
    "@seuoffice/google-drive": "*",
    "@seuoffice/cli": "*",
    "@seuoffice/i18n": "*",
    "@seuoffice/pipelines": "*",
    "@seuoffice/pptx-engine": "*",
    "@seuoffice/pptx-render": "*",
    "@seuoffice/sheets": "*",
    "@seuoffice/slides": "*",
    "@seuoffice/ui": "*",
    "@seuoffice/xlsx-gateway": "*",
    "@modelcontextprotocol/sdk": "^1.32.1",
